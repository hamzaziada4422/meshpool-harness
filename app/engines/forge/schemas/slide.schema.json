{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meshpool:forge/slide",
  "title": "Forge slide content",
  "description": "The only thing the content model writes for a slide. No coordinates, colours, fonts or OOXML: the renderer owns layout. Every number carries a provenance ID.",
  "type": "object",
  "required": [
    "id",
    "node",
    "archetype",
    "title"
  ],
  "additionalProperties": false,
  "$defs": {
    "prov": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{1,3}[0-9]+(\\.[0-9]+)?$"
      },
      "description": "Provenance IDs from the intake fact sheet, e.g. F12 (fact), T3.4 (table 3 row 4)"
    },
    "text": {
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 240
        },
        "prov": {
          "$ref": "#/$defs/prov"
        },
        "emphasis": {
          "type": "boolean"
        }
      }
    },
    "bullet": {
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 160
        },
        "level": {
          "enum": [
            0,
            1
          ]
        },
        "prov": {
          "$ref": "#/$defs/prov"
        },
        "icon": {
          "type": "string",
          "description": "icon meaning, e.g. 'growth'; resolved against the one bundled set"
        }
      }
    },
    "series": {
      "type": "object",
      "required": [
        "name",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "prov": {
          "$ref": "#/$defs/prov"
        },
        "highlight": {
          "type": "boolean"
        }
      }
    },
    "chart": {
      "type": "object",
      "required": [
        "kind",
        "categories",
        "series",
        "unit"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "bar",
            "column",
            "stacked_column",
            "stacked_bar",
            "pct_stacked_column",
            "line",
            "combo",
            "waterfall",
            "marimekko",
            "scatter",
            "bubble",
            "gantt",
            "harvey_balls",
            "matrix_2x2",
            "tornado",
            "pie",
            "doughnut"
          ]
        },
        "categories": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/series"
          }
        },
        "unit": {
          "type": "string",
          "description": "e.g. '$M', '%', 'jobs (thousands)'; shown in the exhibit subtitle"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "highlight_categories": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "x": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "scatter/bubble x values; marimekko widths"
        },
        "size": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "bubble sizes"
        },
        "annotations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "category",
              "text"
            ],
            "properties": {
              "category": {},
              "series": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "maxLength": 40
              }
            }
          }
        }
      }
    },
    "table": {
      "type": "object",
      "required": [
        "columns",
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 8
        },
        "rows": {
          "type": "array",
          "maxItems": 14,
          "items": {
            "type": "array"
          }
        },
        "prov": {
          "$ref": "#/$defs/prov"
        },
        "highlight_rows": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "node": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "number"
          ]
        },
        "role": {
          "type": "string"
        },
        "prov": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "required": [
        "label"
      ]
    }
  },
  "properties": {
    "id": {
      "type": "string"
    },
    "node": {
      "type": "string",
      "description": "the approved storyline node this slide proves (P12)"
    },
    "section": {
      "type": "string",
      "description": "section name; 'Appendix' puts the slide in the appendix section (P16)"
    },
    "archetype": {
      "type": "string",
      "description": "a name from engine-spec.md archetype library (P15); diagrams: risk_matrix, matrix_3x3, gantt, issue_tree, org_chart, cycle, hub_spoke, pyramid, funnel; built-in layouts: layout (with 'layout' and 'slots')"
    },
    "title": {
      "type": "string",
      "maxLength": 120,
      "description": "action title: one sentence, a verb, <=15 words (P11)"
    },
    "title_prov": {
      "$ref": "#/$defs/prov"
    },
    "subtitle": {
      "type": "string",
      "maxLength": 100,
      "description": "exhibit subtitle: what is measured, unit, period"
    },
    "bullets": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/bullet"
      }
    },
    "panels": {
      "type": "array",
      "maxItems": 4,
      "description": "columns/cards/quadrants/phases, archetype-dependent",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "heading": {
            "type": "string",
            "maxLength": 40
          },
          "bullets": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "$ref": "#/$defs/bullet"
            }
          },
          "value": {
            "$ref": "#/$defs/text"
          },
          "icon": {
            "type": "string"
          },
          "rating": {
            "type": "number",
            "minimum": 0,
            "maximum": 4
          }
        }
      }
    },
    "chart": {
      "$ref": "#/$defs/chart"
    },
    "charts": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/chart"
      }
    },
    "table": {
      "$ref": "#/$defs/table"
    },
    "takeaway": {
      "$ref": "#/$defs/text"
    },
    "source": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 200
        },
        "prov": {
          "$ref": "#/$defs/prov"
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "speaker notes; detail cut from the slide goes here"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "numbers the model could not source; rendered as visible [GAP] markers (P13)"
    },
    "layout": {
      "type": "string",
      "description": "grid: full, halves, halves_v, thirds, quarters, main_side, side_main, main_stack, stack_main; layout archetype: the built-in layout id"
    },
    "look": {
      "type": "string",
      "enum": [
        "editorial",
        "boxed",
        "minimal",
        "bold"
      ]
    },
    "parts": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "type"
        ]
      },
      "description": "grid parts; a diagram part takes the fields of its archetype"
    },
    "exhibit_title": {
      "type": "string",
      "description": "diagrams: the heading over the diagram (else the subtitle)"
    },
    "items": {
      "type": "array",
      "maxItems": 12,
      "description": "risk_matrix, matrix_3x3",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "x": {
            "type": [
              "integer",
              "string"
            ],
            "description": "1-3, or low / medium / high"
          },
          "y": {
            "type": [
              "integer",
              "string"
            ],
            "description": "1-3, or low / medium / high"
          },
          "prov": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "label",
          "x",
          "y"
        ]
      }
    },
    "x_axis": {
      "type": "string"
    },
    "y_axis": {
      "type": "string"
    },
    "cells": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "array",
        "maxItems": 3,
        "items": {
          "type": "string"
        }
      },
      "description": "matrix_3x3 zone names, top row first"
    },
    "periods": {
      "type": "array",
      "minItems": 3,
      "maxItems": 16,
      "items": {
        "type": "string"
      },
      "description": "gantt"
    },
    "rows": {
      "type": "array",
      "description": "gantt rows {label, start, end, group, milestones [{at, label}], highlight}; challenge_matrix rows"
    },
    "root": {
      "description": "issue_tree: the question or metric (string); org_chart: {label, role}",
      "type": [
        "string",
        "object"
      ]
    },
    "branches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "description": "issue_tree"
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "description": "org_chart"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "prov": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "title"
        ]
      },
      "description": "cycle (3-6); closing steps"
    },
    "center": {
      "type": "string",
      "description": "cycle"
    },
    "hub": {
      "type": "string",
      "description": "hub_spoke"
    },
    "spokes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "prov": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "title"
        ]
      },
      "description": "hub_spoke"
    },
    "levels": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "prov": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "title"
        ]
      },
      "description": "pyramid, top first"
    },
    "stages": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "description": "funnel, widest first",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "number"
            ]
          },
          "text": {
            "type": "string"
          },
          "prov": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "label"
        ]
      }
    },
    "highlight": {
      "description": "diagrams: the one node, row or step to emphasise"
    },
    "callout": {
      "type": "object"
    },
    "slots": {
      "type": [
        "object",
        "array"
      ],
      "description": "layout and library: slot number -> text"
    },
    "item": {
      "type": "string",
      "description": "library: the private library item id (local only)"
    }
  }
}