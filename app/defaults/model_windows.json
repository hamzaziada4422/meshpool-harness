{
  "about": "Context windows (tokens, input plus output) by model-name pattern, first match wins. Looked up after a user override, a size the provider reports (/models, Ollama /api/show, LM Studio) and a profile's limits.context_window. A copy in the Meshpool data folder (model_windows.json) is read first. Checked against provider docs in 2026-11; entries marked uncertain are best estimates, so set MESHPOOL_CONTEXT_WINDOW or let the provider's own metadata decide.",
  "default_hosted": 200000,
  "default_local": 8192,
  "models": [
    {"match": "claude-(?:fable|mythos)|claude-(?:opus|sonnet|haiku)-5|claude-opus-4[.-][6-9]|claude-sonnet-4[.-][6-9]", "window": 1000000, "source": "platform.claude.com context-windows"},
    {"match": "claude", "window": 200000, "source": "platform.claude.com models overview (Opus 4/4.1/4.5, Sonnet 4/4.5, Haiku 4.5 and older)"},
    {"match": "meshpool-fast", "window": 128000, "source": "llm.meshpool.ai /v1/models max_input_tokens"},
    {"match": "meshpool-balanced", "window": 200000, "source": "llm.meshpool.ai /v1/models max_input_tokens"},
    {"match": "meshpool-max", "window": 160000, "source": "llm.meshpool.ai /v1/models max_input_tokens"},
    {"match": "gpt-oss", "window": 131072, "source": "OpenAI gpt-oss model card: 128k"},
    {"match": "grok-?4(?:[.-]1)?-fast", "window": 2000000, "source": "xAI docs: Grok 4 Fast 2M"},
    {"match": "grok-?[4-9]", "window": 256000, "uncertain": true, "source": "xAI docs: Grok 4 256k; later versions assumed equal"},
    {"match": "grok", "window": 131072, "uncertain": true, "source": "xAI Grok 2/3: 131k"},
    {"match": "gpt-?5", "window": 400000, "source": "OpenAI docs: 272k input + 128k output"},
    {"match": "gpt-?6", "window": 400000, "uncertain": true, "source": "assumed equal to GPT-5"},
    {"match": "gpt-?4\\.1", "window": 1047576, "source": "OpenAI docs"},
    {"match": "gpt-?4o|gpt-?4-turbo|chatgpt-4o", "window": 128000, "source": "OpenAI docs"},
    {"match": "(?:^|[/:-])o[134](?:-|$)", "window": 200000, "source": "OpenAI docs (o1, o3, o4-mini)"},
    {"match": "gpt-?4(?![.o0-9])", "window": 8192, "source": "OpenAI docs (original GPT-4)"},
    {"match": "gpt-?3\\.5", "window": 16385, "source": "OpenAI docs"},
    {"match": "gemini-?1\\.5-pro", "window": 2097152, "source": "Google AI docs"},
    {"match": "gemini", "window": 1048576, "source": "Google AI docs (long-context page: 1,048,576)"},
    {"match": "deepseek.*v4", "window": 1048576, "source": "api-docs.deepseek.com pricing page: 1M"},
    {"match": "deepseek", "window": 131072, "uncertain": true, "source": "DeepSeek V3/R1 era: 128k (65k on early V3 API)"},
    {"match": "kimi-?k3", "window": 1048576, "source": "Moonshot docs"},
    {"match": "kimi-?k2[.-]?(?:5|6|0905|thinking)|kimi-?k2\\.[56]", "window": 262144, "source": "Moonshot docs"},
    {"match": "kimi|moonshot", "window": 131072, "source": "Kimi K2 0711: 131,072"},
    {"match": "glm-?5", "window": 200000, "uncertain": true, "source": "GLM-5 family; some listings say 1M"},
    {"match": "glm-?4[.-]?[67]", "window": 200000, "source": "Z.ai docs"},
    {"match": "glm", "window": 131072, "source": "Z.ai docs (GLM-4.5: 128k)"},
    {"match": "qwen-?3.*(?:coder|2507|instruct-2507|thinking-2507)", "window": 262144, "uncertain": true, "source": "Qwen3 2507 / Coder: 256k native"},
    {"match": "qwen-?3", "window": 131072, "uncertain": true, "source": "Qwen3 base: 32k native, 128k with YaRN"},
    {"match": "qwen-?2\\.5|qwen2\\.5", "window": 32768, "source": "Qwen2.5: 32k (128k on the larger sizes with YaRN)"},
    {"match": "qwen", "window": 32768, "uncertain": true, "source": "older Qwen"},
    {"match": "llama-?4-?scout", "window": 10000000, "uncertain": true, "source": "Meta: 10M advertised; hosts usually serve far less, the provider's metadata wins"},
    {"match": "llama-?4", "window": 1000000, "uncertain": true, "source": "Meta: Maverick 1M"},
    {"match": "llama-?3[.-][123]", "window": 131072, "source": "Meta: 128k"},
    {"match": "llama-?3", "window": 8192, "source": "Meta Llama 3: 8k"},
    {"match": "llama-?2", "window": 4096, "source": "Meta Llama 2: 4k"},
    {"match": "codestral", "window": 262144, "uncertain": true, "source": "Mistral docs"},
    {"match": "mistral-(?:large|medium)|devstral|magistral", "window": 131072, "uncertain": true, "source": "Mistral docs: 128k"},
    {"match": "mistral|mixtral|ministral", "window": 32768, "uncertain": true, "source": "Mistral 7B / Mixtral / Small: 32k"},
    {"match": "gemma-?3", "window": 131072, "source": "Google Gemma 3: 128k (1B: 32k)"},
    {"match": "gemma", "window": 8192, "source": "Google Gemma 1/2: 8k"},
    {"match": "phi-?4", "window": 16384, "source": "Microsoft Phi-4: 16k"},
    {"match": "phi-?3", "window": 4096, "uncertain": true, "source": "Phi-3 mini 4k (128k variants exist)"},
    {"match": "tinyllama|smollm", "window": 2048, "source": "model cards"}
  ]
}
